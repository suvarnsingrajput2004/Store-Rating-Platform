# ============================================================================
# Store Rating Platform — Production Environment Variables
# ============================================================================
# Copy the relevant section into each Railway service's "Variables" tab.
# DO NOT commit real secrets to Git. This file only documents the required
# variable names and where to find the values.
#
# Railway variable references (${{ServiceName.VAR}}) are automatically resolved
# at runtime — use them to link the MySQL plugin values to the backend service.
# ============================================================================


# ============================================================================
# BACKEND SERVICE — set these in Railway dashboard → Backend → Variables
# ============================================================================

NODE_ENV=production

# Railway assigns PORT automatically — do NOT set this manually.
# The backend already reads process.env.PORT with a fallback to 5000.
# PORT=<assigned-by-railway>

# --- MySQL (use Railway variable references to auto-link from the DB plugin) ---
DB_HOST=${{MySQL.MYSQLHOST}}
DB_USER=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
DB_NAME=${{MySQL.MYSQLDATABASE}}
DB_PORT=${{MySQL.MYSQLPORT}}

# --- JWT ---
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret_at_least_64_chars
JWT_EXPIRES_IN=20m

# --- CORS ---
# Set to the Railway URL of your FRONTEND service (no trailing slash).
# Example: https://store-rating-frontend-production.up.railway.app
ALLOWED_ORIGINS=https://your-frontend.up.railway.app


# ============================================================================
# FRONTEND SERVICE — set these in Railway dashboard → Frontend → Variables
# ============================================================================

# Railway assigns PORT automatically — do NOT set this manually.
# The nginx.conf template reads ${PORT} at container startup.
# PORT=<assigned-by-railway>

# The public Railway URL of your BACKEND service (no trailing slash).
# Example: https://store-rating-backend-production.up.railway.app
NGINX_BACKEND_URL=https://your-backend.up.railway.app


# ============================================================================
# MYSQL PLUGIN — auto-provided by Railway (read-only reference)
# ============================================================================
# These are automatically available from the Railway MySQL plugin.
# You do NOT set them manually; just reference them in the backend via ${{MySQL.*}}
#
# MYSQLHOST=<railway-internal-host>
# MYSQLPORT=3306
# MYSQLUSER=root
# MYSQLPASSWORD=<auto-generated>
# MYSQLDATABASE=railway
# MYSQL_ROOT_PASSWORD=<auto-generated>
# DATABASE_URL=mysql://root:<password>@<host>:<port>/railway
